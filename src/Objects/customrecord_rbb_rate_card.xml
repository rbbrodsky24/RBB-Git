<?xml version="1.0" encoding="UTF-8"?>
<!--
  RBB Rate Card  – custom record that groups billing rates by employee class.
  One rate card is assigned to a Project (Job) via custentity_rbb_rate_card.
-->
<customrecordtype scriptid="customrecord_rbb_rate_card">
  <name>RBB Rate Card</name>
  <recordname>Rate Card</recordname>
  <enablesearch>T</enablesearch>
  <isinactive>F</isinactive>
  <customrecordcustomfields>

    <!-- Customer (optional: blank = global / default card) -->
    <customrecordcustomfield scriptid="custrecord_rbb_rc_customer">
      <fieldtype>SELECT</fieldtype>
      <label>Customer</label>
      <selectrecordtype>-2</selectrecordtype>
      <isglobaladmin>F</isglobaladmin>
      <ismandatory>F</ismandatory>
    </customrecordcustomfield>

    <!-- ISO 4217 currency code stored as free text (e.g. USD, EUR) -->
    <customrecordcustomfield scriptid="custrecord_rbb_rc_currency">
      <fieldtype>TEXT</fieldtype>
      <label>Currency</label>
      <ismandatory>T</ismandatory>
      <defaultvalue>USD</defaultvalue>
    </customrecordcustomfield>

    <!-- Effective date range -->
    <customrecordcustomfield scriptid="custrecord_rbb_rc_effective_from">
      <fieldtype>DATE</fieldtype>
      <label>Effective From</label>
      <ismandatory>T</ismandatory>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_rbb_rc_effective_to">
      <fieldtype>DATE</fieldtype>
      <label>Effective To</label>
      <ismandatory>F</ismandatory>
    </customrecordcustomfield>

    <!-- Active flag -->
    <customrecordcustomfield scriptid="custrecord_rbb_rc_is_active">
      <fieldtype>CHECKBOX</fieldtype>
      <label>Active</label>
      <defaultchecked>T</defaultchecked>
    </customrecordcustomfield>

    <!-- Free-text notes -->
    <customrecordcustomfield scriptid="custrecord_rbb_rc_notes">
      <fieldtype>TEXTAREA</fieldtype>
      <label>Notes</label>
      <ismandatory>F</ismandatory>
    </customrecordcustomfield>

  </customrecordcustomfields>
</customrecordtype>
